# Recorder API Port
PORT=3000

# Secret API Key required in X-API-Key header for controlling recordings
RECORDER_API_KEY=local-dev-secret-key-123

# Display & Video Resolution
DISPLAY=:99
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30

# Encoding Bitrates
VIDEO_BITRATE=4M
AUDIO_BITRATE=128k

# Segment Duration (in seconds)
# E.g. 30 for fast testing, 600 for 10-minute production segments
SEGMENT_DURATION_SEC=30

# PulseAudio Virtual Sink Name
PULSE_SINK_NAME=jitsi_virtual_sink

# Recordings Storage Directory
RECORDINGS_DIR=/recordings

# Minimum Free Disk Space in MB before triggering safety stop
MIN_DISK_SPACE_MB=1024

# Default Bot Display Name in Jitsi Meet
BOT_DISPLAY_NAME=Course Recorder

# Optional: Jitsi JWT secret or token if JWT auth is enabled
# JITSI_JWT=
